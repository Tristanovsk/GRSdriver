flowchart LR
    subgraph main["Input Main data"]
        IN1["Level-1 product<br/>Sentinel-2: L1C SAFE (JP2)<br/>Landsat-8/9: Collection-2 L1 (GeoTIFF)<br/>Disk/POSIX"]
    end

    subgraph aux["Input auxiliary data"]
        IN2["Spatial subset (optional)<br/>geopandas GeoSeries or window<br/>Python object"]
    end

    PROC["GRSdriver<br/>Sentinel2Driver / LandsatDriver<br/>(grs_driver CLI for quicklooks)"]

    subgraph out["Output Data"]
        OUT1["L1 product prod<br/>xarray Dataset (numpy or dask)<br/>In memory, passed to GRS"]
        OUT2["RGB quicklook (CLI only)<br/>PNG<br/>Disk/POSIX"]
        OUT3["EOReader temporary cache<br/>GeoTIFF<br/>Disk/POSIX, removed at exit"]
    end

    IN1 --> PROC
    IN2 --> PROC
    PROC --> OUT1
    PROC --> OUT2
    PROC --> OUT3

